# URL base da API do OrkaFlow (backend FastAPI), sem barra no final.
# Em desenvolvimento local: http://127.0.0.1:8000
# Em producao use o IP ou DNS do servidor do back, ex.: http://IP:8000
# (ou a URL publica do proxy reverso, ex.: https://orkaflow.suaempresa.com).
# Variaveis VITE_* sao embutidas no build: rode `npm run build` novamente ao alterar.
VITE_API_URL=http://127.0.0.1:8000
