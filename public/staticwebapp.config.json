{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{svg,png,ico,jpg,jpeg,gif,webp,css,js,woff,woff2,json}"]
  },
  "routes": [
    {
      "route": "/index.html",
      "headers": { "cache-control": "no-cache, no-store, must-revalidate" }
    },
    {
      "route": "/version.json",
      "headers": { "cache-control": "no-cache, no-store, must-revalidate" }
    },
    {
      "route": "/assets/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    }
  ]
}
